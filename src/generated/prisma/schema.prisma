generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Pengajuan Surat - semua data warga disimpan langsung di sini (flat)
model PengajuanSurat {
  id Int @id @default(autoincrement())

  // Data Pemohon (input manual dari form)
  nama_lengkap  String
  no_nik        String
  no_kk         String
  tempat_lahir  String
  tanggal_lahir String
  jenis_kelamin String
  agama         String?
  pekerjaan     String
  alamat        String

  // Foto KTP (URL dari Supabase Storage)
  foto_ktp String? // ✅ Field baru

  // Jenis Surat & Data Tambahan
  jenis_surat   String // domisili, kehilangan, kurang_mampu, lanjut_usia, usaha, belum_menikah, meninggal, berkelakuan_baik
  data_tambahan Json? // field unik per jenis surat

  // Status & Output
  status            String  @default("diajukan") // diajukan, diproses, selesai, ditolak
  no_pengajuan      String? @unique
  catatan_penolakan String?
  nomor_surat       String?
  file_surat        String?

  tanggal_pengajuan DateTime  @default(now())
  tanggal_selesai   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// Admin / Perangkat Desa
model Admin {
  id        Int      @id @default(autoincrement())
  nama      String
  email     String   @unique
  password  String
  jabatan   String   @default("Admin") // Keuchik, Sekretaris Desa, Kaur, Admin
  no_hp     String?
  createdAt DateTime @default(now())
}
